# nginx in front of fleet-server: HTTPS (agents and browsers), HTTP redirected to HTTPS.
# Copy to /etc/nginx/sites-available/fleet, link it into sites-enabled, adjust the certificate paths.
# nginx 1.24 and older need `listen 443 ssl http2`; newer versions use `http2 on;`.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 302 https://$host$request_uri;
}

server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name _;

    # A self-signed certificate is fine: agents use TLS for encryption only. Make one that never expires with e.g.
    #   openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -days 2900000 -subj "/CN=fleet" \
    #     -addext "subjectAltName=IP:<server ip>" -keyout /etc/ssl/private/fleet.key -out /etc/ssl/certs/fleet.crt
    ssl_certificate     /etc/ssl/certs/fleet.crt;
    ssl_certificate_key /etc/ssl/private/fleet.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;          # agents connect with a WebSocket to /agent
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
    }
}
