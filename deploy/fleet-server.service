# fleet-server as a systemd service. Template: ./install.sh fills in @APP_DIR@, @NODE@ and @USER@ and installs it as
# /etc/systemd/system/fleet-server.service. Settings go in .env in the app folder (see lib/config.js).
[Unit]
Description=fleet-server (web page + API over HTTPS; machines connect through their fleet-agent)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=@USER@
WorkingDirectory=@APP_DIR@
ExecStart=@NODE@ server.js
# Lets it listen on ports 80 and 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
