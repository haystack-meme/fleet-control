# fleet-server as a systemd service. Template: ./install.sh fills in the @...@ values and installs it as
# /etc/systemd/system/fleet-server.service. Settings go in .env in the app folder (see lib/config.js).
#
# The server runs commands on machines only by asking their agents; it needs no privileges on its own machine beyond
# binding ports 80 and 443. So it is sandboxed: the whole filesystem is read-only to it except its data folder; it
# sees its code and the public file folder (read-only) and nothing of /home or /root; no devices, no kernel settings,
# no other processes. (Not set, on purpose: MemoryDenyWriteExecute, which Node's JIT needs, and PrivateUsers, which
# would take away the capability to bind ports 80 and 443.)
[Unit]
Description=fleet-server (web page + API over HTTPS; machines connect through their fleet-agent)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=@USER@
WorkingDirectory=@APP_DIR@
ExecStart=@NODE@ server.js
Restart=always
RestartSec=2
UMask=0077

# Lets it listen on ports 80 and 443 without running as root; no other capabilities.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Filesystem: read-only everywhere; /home and /root are empty; the paths it uses are bound in.
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=@DATA_DIR@
BindReadOnlyPaths=@READ_ONLY_PATHS@
PrivateTmp=yes
PrivateDevices=yes

# Kernel, processes and the rest of the system.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
# Internet + local sockets; netlink to list its IP addresses (for the certificate it makes on first start).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
