# Copy to .env (which is never committed) and fill in.
# Password for the MariaDB user `fleet`; make one with: openssl rand -hex 24
FLEET_DB_PASSWORD=
# Optional: names in the self-signed certificate, e.g. IP:192.0.2.10,DNS:fleet
#FLEET_CERT_NAMES=DNS:fleet
# Optional: host ports (defaults 80 and 443)
#FLEET_HTTP_PORT=80
#FLEET_HTTPS_PORT=443
